# Moss Cloud project credentials (https://moss.dev).
# Used by scripts/build-index.ts to build + publish the indexes, and served to
# the browser at request time by /api/moss-config: @moss-dev/moss-web needs the
# key client-side, so use a project that holds only these public-corpus indexes.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Embedding model for both indexes: moss-minilm (fastest, browser default) | moss-mediumlm
MOSS_MODEL=moss-minilm

# Optional: enables LLM-generated counter-line variants (server action).
# Gemini is used when set, otherwise Claude. Only the scam family and stage
# are sent, never the transcript.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
